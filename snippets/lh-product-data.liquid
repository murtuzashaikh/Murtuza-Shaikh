{%- comment -%}
  Outputs per-variant data for lh-product-form. Discounts and offer prices are calculated here in Liquid.
  Accepts:
  - product: {Object} Product
{%- endcomment -%}
{%- assign offers = product.metafields.custom.offers.value -%}
<script type="application/json" data-lh-variants>
  [
    {%- for variant in product.variants -%}
      {%- liquid
        assign save = 0
        if variant.compare_at_price > variant.price
          assign save = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
        endif
        assign image = variant.featured_image | default: product.featured_image
      -%}
      {
        "id": {{ variant.id }},
        "options": {{ variant.options | json }},
        "available": {{ variant.available | json }},
        "price": {{ variant.price | money | json }},
        "compare": {% if save > 0 %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
        "save": {{ save }},
        "media": {{ variant.featured_media.id | json }},
        "image": {% if image != blank %}{{ image | image_url: width: 720 | json }}{% else %}null{% endif %},
        "ribbon": {{ variant.metafields.custom.ribbon.value | json }},
        "offers": [
          {%- for offer in offers -%}
            {%- assign factor = 100 | minus: offer.discount_percent.value -%}
            {{- variant.price | times: factor | divided_by: 100.0 | round | money | json -}}
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>
