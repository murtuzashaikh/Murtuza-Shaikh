{%- comment -%}
  Renders a Loomhaus SVG icon.
  Accepts:
  - name: {String} arrow-right | cart | plus | close | chevron-down | chevron-left | chevron-right | check-circle | star | offer | copy
  - class: {String} optional extra class
{%- endcomment -%}
{%- capture classes -%}lh-icon lh-icon--{{ name }}{% if class != blank %} {{ class }}{% endif %}{%- endcapture -%}
{%- case name -%}
  {%- when 'arrow-right' -%}
    <svg class="{{ classes }}" viewBox="0 0 20 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M1 6h17M13.5 1.5 18 6l-4.5 4.5"/></svg>
  {%- when 'cart' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 8.5h14l-1.1 11.6a1 1 0 0 1-1 .9H7.1a1 1 0 0 1-1-.9L5 8.5Z"/><path d="M9 8.5V6.5a3 3 0 0 1 6 0v2"/></svg>
  {%- when 'plus' -%}
    <svg class="{{ classes }}" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M7 1v12M1 7h12"/></svg>
  {%- when 'close' -%}
    <svg class="{{ classes }}" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m5 5 12 12M17 5 5 17"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="{{ classes }}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m4 6 4 4 4-4"/></svg>
  {%- when 'chevron-left' -%}
    <svg class="{{ classes }}" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m11 4-5 5 5 5"/></svg>
  {%- when 'chevron-right' -%}
    <svg class="{{ classes }}" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m7 4 5 5-5 5"/></svg>
  {%- when 'check-circle' -%}
    <svg class="{{ classes }}" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><circle cx="16" cy="16" r="15" fill="currentColor"/><path d="m10.5 16.5 3.5 3.5 7.5-7.5" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'star' -%}
    <svg class="{{ classes }}" viewBox="0 0 18 18" aria-hidden="true" focusable="false"><path fill="currentColor" d="m9 1.2 2.3 4.9 5.3.6-3.9 3.7 1 5.3L9 13.1l-4.7 2.6 1-5.3-3.9-3.7 5.3-.6L9 1.2Z"/></svg>
  {%- when 'offer' -%}
    <svg class="{{ classes }}" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="13" cy="13" r="11"/><path d="m9.5 16.5 7-7"/><circle cx="10" cy="10" r="1.2" fill="currentColor" stroke="none"/><circle cx="16" cy="16" r="1.2" fill="currentColor" stroke="none"/></svg>
  {%- when 'copy' -%}
    <svg class="{{ classes }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="7" y="7" width="10.5" height="10.5" rx="2"/><path d="M13 7V4.5a2 2 0 0 0-2-2H4.5a2 2 0 0 0-2 2V11a2 2 0 0 0 2 2H7"/></svg>
{%- endcase -%}
