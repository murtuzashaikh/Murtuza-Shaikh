{%- liquid
  assign current = product.selected_or_first_available_variant
  assign image = current.featured_image | default: product.featured_image
  capture selected
    echo '['
    for option in product.options_with_values
      assign option_name = option.name | downcase
      if option_name == 'color' or option_name == 'colour'
        echo option.selected_value | json
      else
        echo 'null'
      endif
      unless forloop.last
        echo ','
      endunless
    endfor
    echo ']'
  endcapture
-%}
<lh-product-form class="lh lh-qv" data-lh-qv data-selected="{{ selected | escape }}">
  <span class="lh-qv__handle" aria-hidden="true"></span>
  <div class="lh-qv__media" data-lh-image>
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 720
        | image_tag: sizes: '(min-width: 750px) 240px, 100vw', widths: '240, 360, 480, 720', alt: product.title
      }}
    {%- endif -%}
  </div>

  <div class="lh-qv__details">
    <div class="lh-qv__head">
      <div>
        <h2 class="lh-qv__title">{{ product.title | escape }}</h2>
        <p class="lh-qv__price" data-lh-price>{{ current.price | money }}</p>
      </div>
      <button type="button" class="lh-icon-button" data-lh-quick-view-close aria-label="{{ 'accessibility.close' | t }}">
        {%- render 'lh-icon', name: 'close' -%}
      </button>
    </div>

    {%- if product.description != blank -%}
      <p class="lh-qv__description">{{ product.description | strip_html | truncatewords: 40 }}</p>
    {%- endif -%}

    {%- for option in product.options_with_values -%}
      {%- assign option_index = forloop.index0 -%}
      {%- assign option_name = option.name | downcase -%}
      {%- if option_name == 'color' or option_name == 'colour' -%}
        <fieldset class="lh-option">
          <legend class="lh-option__label">{{ option.name | escape }}</legend>
          <div class="lh-colors">
            {%- for value in option.values -%}
              <button
                type="button"
                class="lh-color"
                data-option-index="{{ option_index }}"
                data-option-value="{{ value | escape }}"
                aria-pressed="{% if value == option.selected_value %}true{% else %}false{% endif %}"
                style="--lh-swatch: {% render 'lh-swatch-color', value: value %}"
              >
                <span class="lh-color__dot" aria-hidden="true"></span>
                {{- value | escape -}}
              </button>
            {%- endfor -%}
          </div>
        </fieldset>
      {%- else -%}
        <div class="lh-option">
          <label class="lh-option__label" for="LhQuickViewOption-{{ product.id }}-{{ option_index }}">
            {{- option.name | escape -}}
          </label>
          <div class="lh-select">
            <select
              id="LhQuickViewOption-{{ product.id }}-{{ option_index }}"
              data-option-index="{{ option_index }}"
              class="is-placeholder"
            >
              <option value="">{{ 'loomhaus.choose_option' | t: option: option_name }}</option>
              {%- for value in option.values -%}
                <option value="{{ value | escape }}">{{ value | escape }}</option>
              {%- endfor -%}
            </select>
            {%- render 'lh-icon', name: 'chevron-down' -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <button type="button" class="lh-btn lh-btn--primary lh-btn--square lh-btn--block" data-lh-add disabled>
      <span
        data-lh-add-label
        data-default="{{ 'products.product.add_to_cart' | t | escape }}"
        data-sold-out="{{ 'products.product.sold_out' | t | escape }}"
      >
        {{- 'products.product.add_to_cart' | t -}}
      </span>
      {%- render 'lh-icon', name: 'arrow-right' -%}
    </button>
    <p class="lh-form-error" data-lh-error role="alert"></p>
  </div>

  {%- render 'lh-product-data', product: product -%}
</lh-product-form>

{% schema %}
{
  "name": "Loomhaus quick view"
}
{% endschema %}
