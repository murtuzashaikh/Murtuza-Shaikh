{%- liquid
  assign card_product = section.settings.card_product
  assign stats = section.blocks | where: 'type', 'stat'
-%}
<section class="lh lh-hero" aria-labelledby="LhHeroHeading-{{ section.id }}">
  <div class="lh-container lh-hero__inner">
    <div class="lh-hero__content">
      {%- if section.settings.badge != blank -%}
        <p class="lh-pill-badge">{{ section.settings.badge | escape }}</p>
      {%- endif -%}
      <h1 id="LhHeroHeading-{{ section.id }}" class="lh-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="lh-hero__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          class="lh-btn lh-btn--primary lh-hero__button"
        >
          {{- section.settings.button_label | escape -}}
          {%- render 'lh-icon', name: 'arrow-right' -%}
        </a>
      {%- endif -%}
      {%- if stats.size > 0 -%}
        <dl class="lh-stats">
          {%- for block in stats -%}
            <div class="lh-stats__item" {{ block.shopify_attributes }}>
              <dt class="lh-stats__value">{{ block.settings.value | escape }}</dt>
              <dd class="lh-stats__label">{{ block.settings.label | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>

    <div class="lh-hero__visual">
      <div class="lh-hero__circle" aria-hidden="true"></div>
      <div class="lh-hero__image">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1320
            | image_tag:
              widths: '330, 440, 660, 880, 1320',
              sizes: '(min-width: 1200px) 440px, (min-width: 750px) 362px, 300px',
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      {%- if card_product != blank -%}
        <a href="{{ card_product.url }}" class="lh-floating-card">
          {%- if card_product.featured_image != blank -%}
            {{
              card_product.featured_image
              | image_url: width: 72, height: 72, crop: 'top'
              | image_tag: class: 'lh-floating-card__image', alt: '', loading: 'lazy'
            }}
          {%- endif -%}
          <span>
            <span class="lh-floating-card__title">{{ card_product.title | escape }}</span>
            {%- if section.settings.card_caption != blank -%}
              <span class="lh-floating-card__caption">
                {{- section.settings.card_caption | escape -}}
              </span>
            {%- endif -%}
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Loomhaus hero",
  "class": "lh-hero-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "NEW SEASON  ·  AUTUMN / WINTER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Winter Edit"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Warm layers, honest fabrics and fits that work every day. Discover the pieces our community wears on repeat this season."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Floating card"
    },
    {
      "type": "product",
      "id": "card_product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "card_caption",
      "label": "Caption",
      "default": "Bestseller this week"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "4.8★"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "2,000+ reviews"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Loomhaus hero",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "4.8★",
            "label": "2,000+ reviews"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "100%",
            "label": "organic cotton"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "30 days",
            "label": "free returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}
