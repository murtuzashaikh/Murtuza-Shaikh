{%- if section.blocks.size > 0 -%}
  <div class="lh lh-announcement" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
    <div class="lh-announcement__inner">
      {%- for block in section.blocks -%}
        {%- unless forloop.first -%}
          <span class="lh-announcement__separator" aria-hidden="true">✦</span>
        {%- endunless -%}
        <p class="lh-announcement__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Loomhaus announcement",
  "class": "lh-announcement-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over ₹999"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Loomhaus announcement",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Free shipping on orders over ₹999"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Use code LOOM10 for 10% off your first order"
          }
        }
      ]
    }
  ]
}
{% endschema %}
